{
  "name": "RoTerra",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Common": {
        "$path": "src/shared"
      },
      "CommonAssets": {
        "$path": "assets/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$path": "assets/StarterPlayer",
      "StarterCharacterScripts": {

      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "ServerStorage": {
      "ServerAssets": {
        "$path": "assets/server"
      }
    },

    "ReplicatedFirst": {
      "ClientInit": {
        "$path": "src/init"
      },
      "InitAssets": {
        "$path": "assets/init"
      }
    },

    "Workspace": {
      "Game": {
        "$path": "assets/workspace"
      },
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "MaterialService": {
      "$properties": {
        "Use2022Materials": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
